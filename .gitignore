__pycache__/
*.py[cod]
.venv/
venv/
samples/out/
app/.font_cache.json
*.log
.DS_Store

# 自定义字体：保留目录与说明，但不要把字体文件提交出去
# （很多人用的是有版权的商业字体，不适合随代码分发）
fonts/*
!fonts/README.md

# 图片生成模块的中转站配置：内含 API key，绝不入库
data/

# 快照 zip 是离线副本，不属于源码
*.zip
!samples/**/*.zip

# 写提交信息用的临时文件（避免被 git add -A 收进来）
.commitmsg.tmp

# 依赖目录（各子项目各自的 .gitignore 之外，这里兜一层）
node_modules/

# WorkBuddy 工作区数据：只留会话记录，其余（临时备份等）不入库
.workbuddy/*
!.workbuddy/memory/
